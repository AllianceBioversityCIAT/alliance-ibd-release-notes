{
  "version": 1,
  "framework": { "name": "angular", "version": "22.2.0" },
  "routes": [
    {
      "path": "/*.*",
      "target": { "kind": "Static", "cacheControl": "public, max-age=2" },
      "fallback": { "kind": "Compute", "src": "default" }
    },
    {
      "path": "/*",
      "target": { "kind": "Compute", "src": "default" }
    }
  ],
  "computeResources": [
    { "name": "default", "runtime": "nodejs22.x", "entrypoint": "server.mjs" }
  ]
}
